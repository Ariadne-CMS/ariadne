<?php
	/******************************************************************
	 system.save.password.phtml                            Muze Ariadne
	 ------------------------------------------------------------------
	 Arguments: password
	 Grant needed: edit (existing users only)
	 Result: saved object path, or false on failure

	 Changes only the password, preserving other stored user fields,
	 including password expiry. Normal save events and workflows apply.
	******************************************************************/
	$arResult = false;
	if (!$this->arIsNewObject && $this->CheckLogin("edit") && $this->CheckConfig()) {
		$this->error = null;
		// Read input only: getdata() would fall back to the stored password hash.
		$password = $this->getvar("password");
		if (!is_string($password) || $password === '') {
			$this->error = ar::error($ARnls["err:validpassword"], 1203);
			return false;
		}

		// Discard unsaved changes and ignore unrelated request parameters.
		$this->data = current($this->get(".", "system.get.data.phtml"));
		if ($password === '!') {
			// Preserve the unusable-password marker supported by system.save.data.
			$this->data->password = '!';
		} else {
			$this->data->password = $this->hashPassword($password);
		}

		// Existing password-sync handlers expect the legacy argument names.
		// Expose them only during save; callers supply just password.
		global $ARCurrent;
		$ARCurrent->arCallStack[] = array(
			'password' => $password,
			'newpass1' => $password,
			'newpass2' => $password
		);
		try {
			$arResult = $this->save();
		} finally {
			array_pop($ARCurrent->arCallStack);
		}
		if ($arResult && !$this->error) {
			global $cache_config;
			$cachestore = new cache($cache_config);
			$cachestore->onObjectSaved($this->id);
		}
	}
?>
