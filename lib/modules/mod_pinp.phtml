										} 
										$tag_element = "";
										while ($yych != ' ' && ord($yych)!==0 && $yych != '>') {
											$tag_element .= $yych;
											$yych = $YYBUFFER[++$YYCURSOR];
										}
										while (ord($yych)!==0 && $yych!='>') {
											$yych = $YYBUFFER[++$YYCURSOR];
										}
										if ($yych=='>') {
											++$YYCURSOR;
										}

										if (preg_match('|^compile:([a-z]+)|i', $tag_element, $matches)) {
