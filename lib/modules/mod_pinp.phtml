			'asort' => [0], 'arsort' => [0], 'natsort' => [0], 'natcasesort' => [0],
			'usort' => [0], 'uasort' => [0], 'uksort' => [0],
			'array_walk' => [0], 'array_walk_recursive' => [0],
			'reset' => [0], 'next' => [0], 'prev' => [0], 'end' => [0],
			'extract' => [0], 'each' => [0], 'settype' => [0],
			'collator_asort' => [1],
			'collator_sort' => [1],
			'collator_sort_with_sort_keys' => [1],
			'datefmt_localtime' => [2],
			'datefmt_parse' => [2],
			'getimagesizefromstring' => [1],
			'grapheme_extract' => [4],
			'idn_to_ascii' => [3],
			'idn_to_utf8' => [3],
			'intltz_get_canonical_id' => [1],
			'intltz_get_offset' => [3, 4],
			'ldap_parse_exop' => [2, 3],
			'ldap_parse_reference' => [2],
			'numfmt_parse' => [3],
			'numfmt_parse_currency' => [2, 3],
			'openssl_encrypt' => [5],
			'openssl_pkcs12_read' => [1],
			'openssl_pkcs7_read' => [1],
			'sodium_add' => [0],
			'sodium_crypto_generichash_final' => [0],
			'sodium_crypto_generichash_update' => [0],
			'sodium_crypto_secretstream_xchacha20poly1305_pull' => [0],
			'sodium_crypto_secretstream_xchacha20poly1305_push' => [0],
			'sodium_crypto_secretstream_xchacha20poly1305_rekey' => [0],
			'sodium_increment' => [0],
			'sodium_memzero' => [0],
			'ar::untaint' => [0],
			'ldregisterfile' => [1],
			'preg_match' => [2], 'preg_match_all' => [2], 'preg_filter' => [4],
			'preg_replace' => [4], 'preg_replace_callback' => [4], 'preg_replace_callback_array' => [3],
			'parse_str' => [1], 'str_replace' => [3], 'str_ireplace' => [3],
			'similar_text' => [2], 'is_callable' => [2], 'headers_sent' => [0, 1],
			'getmxrr' => [1, 2], 'dns_get_mx' => [1, 2], 'dns_get_record' => [2, 3],
			'xml_parse_into_struct' => [2, 3],
			'imap_savebody' => [1],
			'mb_ereg' => [2], 'mb_eregi' => [2], 'mb_parse_str' => [1],
			'openssl_sign' => [1], 'openssl_random_pseudo_bytes' => [1],
			'ldap_parse_result' => [2, 3, 4, 5, 6],
			'soapclient::__soapcall' => [4],
			'pdostatement::bindparam' => [1], 'pdostatement::bindcolumn' => [1]
