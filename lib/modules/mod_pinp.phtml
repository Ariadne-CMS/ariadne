						break;
						default:
							while (!($YYCLASSES["START_TRANSITION"][$yych] ?? null) && ord($yych) !== 0) {
								if ($yych == "\n") {
									$this->YYLINE++;
								}
								$yych = $YYBUFFER[++$YYCURSOR];
							}
							$result = substr($YYBUFFER, $YYCURSOR_START, $YYCURSOR-$YYCURSOR_START);
							return PT_UNPARSED;
						break;
					}
				break;
				case YY_STATE_EXT_COMPILE:
						$startLine = $this->YYLINE;
						do {
							while ($yych !== '<' && ord($yych) !== 0) {
								if ($yych == "\n") {
									$this->YYLINE++;
								}
								$yych = $YYBUFFER[++$YYCURSOR];
							}

							if ($yych === '<') {
								$yych = $YYBUFFER[++$YYCURSOR];
								switch ($yych) {
									case '/':
										$yych = $YYBUFFER[++$YYCURSOR];
										while ($yych == ' ') {
